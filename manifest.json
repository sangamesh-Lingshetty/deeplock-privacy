{
  "manifest_version": 3,
  "name": "DeepLock",
  "version": "4.1",
  "description": "Block distracting websites, lock focus sessions, and track deep work progress.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "scripting",
    "tabs",
    "identity",
    "management"
  ],
  "oauth2": {
    "client_id": "523486634791-lnhttaq8cob6q42urt60uaouqag4oko6.apps.googleusercontent.com",
    "scopes": ["openid", "email", "profile"]
  },
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://www.x.com/*",
    "https://x.com/*",
    "https://www.twitter.com/*",
    "https://twitter.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://youtu.be/*",
    "https://www.reddit.com/*",
    "https://reddit.com/*",
    "https://redd.it/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "https://www.netflix.com/*",
    "https://netflix.com/*",
    "https://www.twitch.tv/*",
    "https://twitch.tv/*",
    "https://www.discord.com/*",
    "https://discord.com/*",
    "https://discordapp.com/*",
    "https://app.discord.com/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*",
    "https://www.snapchat.com/*",
    "https://snapchat.com/*",
    "https://www.pinterest.com/*",
    "https://pinterest.com/*",
    "https://news.ycombinator.com/*",
    "https://www.amazon.com/*",
    "https://amazon.com/*",
    "https://www.amazon.in/*",
    "https://amazon.in/*",
    "https://www.flipkart.com/*",
    "https://flipkart.com/*",
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://open.spotify.com/*",
    "https://www.spotify.com/*",
    "https://api.lemonsqueezy.com/*",
    "https://t.co/*",
    "https://messenger.com/*",
    "https://l.messenger.com/*",
    "https://vm.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["smartlock_overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "pause.html",
        "uninstall.html",
        "uninstall.js",
        "hardmode.html",
        "hardmode.js",
        "auto_kill.html",
        "auto_kill.js",
        "dashboard.html",
        "dashboard.css",
        "dashboard.js",
        "chart.min.js",
        "pause.js",
        "blocked.js",
        "supabase.js"
      ],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ]
}
